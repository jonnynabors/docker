{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "dockerfile", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/backup\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on saturday"],
  "packageRules": [
    {
      "description": "Weekly batch of minor and patch updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "homelab minor and patch"
    },
    {
      "description": "Major updates get their own merge request",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "qBittorrent is 5.x; the image also has unrelated tags like 14.3.9 and 20.04.1",
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "/^\\d\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Gluetun is deployed from latest, so track its digest",
      "matchPackageNames": ["qmcgaw/gluetun"],
      "pinDigests": true,
      "groupName": "gluetun"
    }
  ]
}
